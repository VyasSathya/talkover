# Copy to config.env (install.ps1 does this once) and edit. Environment variables override these.
# Read by src/voice_config.py, hooks/speak-response.ps1 and docker compose (--env-file config.env).

# Where logs and learned state go (never inside the repo).
TALKOVER_HOME=~/.talkover

# Engines (docker-compose.yml), on 127.0.0.1. Set TALKOVER_STT_BASE / TALKOVER_TTS_BASE to use engines elsewhere.
TALKOVER_STT_PORT=2022
TALKOVER_TTS_PORT=8880
TALKOVER_WHISPER_CONTAINER=talkover-whisper
TALKOVER_KOKORO_CONTAINER=talkover-kokoro
# Whisper model fetched by install.ps1 (whisper-1 maps to it in engines/model_aliases.json).
TALKOVER_WHISPER_MODEL=Systran/faster-whisper-small

# Spoken replies: any Kokoro voice (af_heart, af_bella, am_adam, bf_emma, ...) and speed.
TALKOVER_VOICE=af_heart
TALKOVER_SPEED=1.05

# Mic: milliseconds of silence that end an utterance (lower = sends sooner).
VOICE_INBOX_FLOOR_MS=600
# Pause the reading when you start talking over it.
VOICE_INBOX_BARGE_IN=true

# UDP port for the mic level the panel's orb follows.
TALKOVER_LEVEL_PORT=42712

# Optional "stop" keyword listener for the VoiceMode MCP server (1 = start it too).
TALKOVER_STOP_WORD=0
